#!/bin/bash
# Start, stop or check ids-live (W17 of docs/development-plan-dashboard-control.md).
#
#   ids-live-ctl start     start it (the default)
#   ids-live-ctl stop      stop it: it analyses what is queued for up to 10
#                          seconds, then counts the rest as a gap
#   ids-live-ctl restart   stop it and start it again, for a new socket,
#                          records folder or live section; rules, profiles
#                          and other settings need no restart (W13)
#   ids-live-ctl status    say whether it runs, and the end of its log
#
# Settings come from the environment:
#
#   IDS_LIVE_CONFIG  the product configuration (required)
#   IDS_LIVE         the program (default: ids-live on the PATH)
#   IDS_LIVE_DIR     where its pid file and log go
#                    (default: ~/.local/state/ids-live)
#   IDS_LIVE_ARGS    more arguments, such as "-records /srv/ids/records"
#
# ids-live runs detached (setsid), so it keeps running when the terminal
# ends. For a server, a systemd unit is the better home; this script is for
# developing and for a lab.
set -u

BIN="${IDS_LIVE:-$(command -v ids-live || true)}"
DIR="${IDS_LIVE_DIR:-$HOME/.local/state/ids-live}"
CFG="${IDS_LIVE_CONFIG:-}"
LOG="$DIR/ids-live.log"
PIDFILE="$DIR/ids-live.pid"

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

need() {
	if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
		echo "ids-live is not found; set IDS_LIVE to the program, or put it on the PATH."
		exit 2
	fi
	if [ -z "$CFG" ] || [ ! -f "$CFG" ]; then
		echo "Set IDS_LIVE_CONFIG to the product configuration ids-live runs."
		exit 2
	fi
}

start() {
	need
	if running; then
		echo "ids-live is already running (pid $(cat "$PIDFILE"))."
		return 0
	fi
	mkdir -p "$DIR"
	# shellcheck disable=SC2086 # IDS_LIVE_ARGS is split on purpose
	setsid nohup "$BIN" -config "$CFG" ${IDS_LIVE_ARGS:-} >> "$LOG" 2>&1 < /dev/null &
	echo $! > "$PIDFILE"
	for _ in $(seq 1 20); do
		sleep 0.25
		if ! running; then
			echo "ids-live stopped at once. The end of $LOG:"
			tail -n 8 "$LOG"
			rm -f "$PIDFILE"
			return 1
		fi
		if tail -n 5 "$LOG" | grep -q '^Listening on '; then
			echo "ids-live runs (pid $(cat "$PIDFILE"))."
			tail -n 5 "$LOG" | grep -E '^(Listening|Records)'
			return 0
		fi
	done
	echo "ids-live started (pid $(cat "$PIDFILE")), but has not said it listens yet; see $LOG."
}

stop() {
	if ! running; then
		echo "ids-live is not running."
		rm -f "$PIDFILE"
		return 0
	fi
	pid=$(cat "$PIDFILE")
	kill -TERM "$pid"
	for _ in $(seq 1 60); do
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PIDFILE"
			echo "ids-live stopped."
			grep '^Stopped:' "$LOG" | tail -n 1
			return 0
		fi
		sleep 0.25
	done
	echo "ids-live (pid $pid) did not stop within 15 seconds; see $LOG."
	return 1
}

status() {
	if running; then
		echo "ids-live runs (pid $(cat "$PIDFILE"))."
	else
		echo "ids-live is not running."
	fi
	[ -f "$LOG" ] && tail -n 5 "$LOG"
	return 0
}

case "${1:-start}" in
start) start ;;
stop) stop ;;
restart) stop && start ;;
status) status ;;
*)
	echo "usage: ids-live-ctl start|stop|restart|status"
	exit 2
	;;
esac
